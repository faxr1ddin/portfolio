---
// A recreation of Quronim's group screen. main.ts animates it as a live
// simulation: members reserve and finish Juz in real time, like the real app.
interface Props {
  mode?: 'live' | 'reserve';
}
const { mode = 'live' } = Astro.props;

const members = [
  { i: 'A', c: '#3b82f6' },
  { i: 'M', c: '#ec4899' },
  { i: 'B', c: '#10b981' },
  { i: 'S', c: '#f59e0b' },
  { i: 'U', c: '#8b5cf6' },
  { i: 'Z', c: '#ef4444' },
];

const done = new Set([1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 13, 15, 16, 18, 20, 21, 23, 26]);
const reserved: Record<number, number> = { 7: 0, 12: 1, 14: 2, 19: 3, 24: 4 };
const doneCount = done.size;
const C = 2 * Math.PI * 42;
---

<div class="hl" data-sim={mode}>
  <div class="hl-banner" data-sim-banner aria-hidden="true">
    <span class="hl-banner-icon">
      <svg viewBox="0 0 24 24"><path d="M4 5.5C6 4.5 9 4.5 12 6.5c3-2 6-2 8-1v13c-2-1-5-1-8 1-3-2-6-2-8-1v-13Z" fill="#fff"></path><path d="M12 6.5v13" stroke="#16305c" stroke-width="1.2"></path></svg>
    </span>
    <span class="hl-banner-text">
      <b>Quronim</b>
      <span data-sim-banner-text>Madina finished Juz 12</span>
    </span>
    <span class="hl-banner-time">now</span>
  </div>

  <div class="hl-head">
    <div>
      <div class="hl-sub">Qur’an · Hatm #3</div>
      <div class="hl-title">Family Hatm</div>
    </div>
    <div class="hl-avatars">
      {members.slice(0, 4).map((m) => <span style={`background:${m.c}`}>{m.i}</span>)}
      <span class="more">+8</span>
    </div>
  </div>

  <div class="hl-card">
    <div class="hl-ring">
      <svg viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="42" class="ring-bg"></circle>
        <circle
          cx="50"
          cy="50"
          r="42"
          class="ring-fg"
          data-sim-ring
          stroke-dasharray={C.toFixed(2)}
          stroke-dashoffset={(C * (1 - doneCount / 30)).toFixed(2)}></circle>
      </svg>
      <div class="hl-ring-label">
        <b data-sim-count>{doneCount}</b><span>/30</span>
        <small>Juz done</small>
      </div>
    </div>
    <div class="hl-stats">
      <div class="hl-live"><i></i>Live</div>
      <div><b data-sim-pct>{Math.round((doneCount / 30) * 100)}%</b><small>complete</small></div>
      <div><b>12</b><small>members</small></div>
    </div>
  </div>

  <div class="hl-grid-head">
    <span>Juz</span>
    <span class="hl-legend"><i class="l-done"></i>Done <i class="l-res"></i>Reserved</span>
  </div>
  <div class="hl-grid">
    {
      Array.from({ length: 30 }, (_, k) => {
        const n = k + 1;
        const r = reserved[n];
        const state = done.has(n) ? 'done' : r !== undefined ? 'reserved' : '';
        return (
          <span class:list={['juz', state, mode === 'reserve' && n === 17 && 'pick']} data-juz={n}>
            {n}
            <i style={r !== undefined ? `background:${members[r].c}` : undefined}>{r !== undefined ? members[r].i : ''}</i>
          </span>
        );
      })
    }
  </div>

  {
    mode === 'reserve' ? (
      <div class="hl-sheet">
        <div class="hl-grab" />
        <div class="hl-sheet-title">Reserve Juz 17</div>
        <div class="hl-sheet-sub">Al‑Anbiyā 1 → Al‑Hajj 78 · ~40 min</div>
        <div class="hl-sheet-btn" data-sim-btn>Reserve for me</div>
      </div>
    ) : (
      <div class="hl-feed" data-sim-feed>
        <span class="hl-feed-dot" style="background:#ec4899">M</span>
        <span data-sim-feed-text>Madina reserved Juz 12</span>
        <span class="hl-feed-time">now</span>
      </div>
    )
  }

  <div class="hl-tabs" aria-hidden="true">
    <span class="on"><svg viewBox="0 0 24 24"><path d="M4 5.5C6 4.5 9 4.5 12 6.5c3-2 6-2 8-1v13c-2-1-5-1-8 1-3-2-6-2-8-1v-13Z"></path></svg>Qur’an</span>
    <span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.5"></circle><circle cx="12" cy="4.5" r="1.6"></circle></svg>Zikr</span>
    <span><svg viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.5"></circle><path d="M5 19.5c1.5-3.5 4-5 7-5s5.5 1.5 7 5"></path></svg>Profile</span>
  </div>
</div>

<style>
  .hl {
    --navy: #16305c;
    --gold: #e0a43a;
    position: absolute;
    inset: 13cqw 0 0;
    padding: 2cqw 5.5cqw 0;
    display: flex;
    flex-direction: column;
    gap: 3.4cqw;
  }
  .hl-banner {
    position: absolute;
    top: -1cqw;
    left: 3cqw;
    right: 3cqw;
    z-index: 25;
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 2.8cqw 3.4cqw;
    border-radius: 6cqw;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2cqw 8cqw rgba(18, 24, 38, 0.18);
    font-size: 3.2cqw;
    transform: translateY(-140%);
    opacity: 0;
  }
  .hl-banner-icon {
    display: grid;
    place-items: center;
    width: 9cqw;
    height: 9cqw;
    border-radius: 2.4cqw;
    background: var(--navy);
    flex: none;
  }
  .hl-banner-icon svg {
    width: 6cqw;
  }
  .hl-banner-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .hl-banner-text span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hl-banner-time {
    margin-left: auto;
    align-self: flex-start;
    color: #8a8f9c;
    font-size: 2.8cqw;
  }
  .hl-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
  }
  .hl-sub {
    font-size: 3cqw;
    color: #7a7f8c;
    font-weight: 500;
  }
  .hl-title {
    font-size: 6.6cqw;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--navy);
  }
  .hl-avatars {
    display: flex;
  }
  .hl-avatars span {
    display: grid;
    place-items: center;
    width: 7cqw;
    height: 7cqw;
    margin-left: -1.8cqw;
    border-radius: 50%;
    border: 0.6cqw solid #f6f3ec;
    color: #fff;
    font-size: 2.8cqw;
    font-weight: 700;
  }
  .hl-avatars .more {
    background: #e4dfd3;
    color: #4b5160;
  }
  .hl-card {
    display: flex;
    align-items: center;
    gap: 5cqw;
    padding: 4cqw;
    border-radius: 6cqw;
    background: var(--navy);
    color: #fff;
  }
  .hl-ring {
    position: relative;
    width: 30cqw;
    flex: none;
  }
  .hl-ring svg {
    transform: rotate(-90deg);
  }
  .ring-bg,
  .ring-fg {
    fill: none;
    stroke-width: 9;
  }
  .ring-bg {
    stroke: rgba(255, 255, 255, 0.12);
  }
  .ring-fg {
    stroke: var(--gold);
    stroke-linecap: round;
    transition: stroke-dashoffset 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hl-ring-label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    align-items: baseline;
    text-align: center;
  }
  .hl-ring-label b {
    font-size: 7.4cqw;
    letter-spacing: -0.04em;
  }
  .hl-ring-label span {
    font-size: 3.4cqw;
    opacity: 0.6;
  }
  .hl-ring-label small {
    width: 100%;
    font-size: 2.6cqw;
    opacity: 0.6;
  }
  .hl-stats {
    display: grid;
    gap: 2cqw;
    font-size: 3cqw;
  }
  .hl-stats b {
    font-size: 4.6cqw;
    margin-right: 1.4cqw;
  }
  .hl-stats small {
    opacity: 0.6;
    font-size: 2.8cqw;
  }
  .hl-live {
    display: inline-flex;
    align-items: center;
    gap: 1.6cqw;
    width: max-content;
    padding: 0.8cqw 2.6cqw;
    border-radius: 99px;
    background: rgba(61, 220, 151, 0.16);
    color: #3ddc97;
    font-weight: 600;
    font-size: 2.8cqw;
  }
  .hl-live i {
    width: 1.6cqw;
    height: 1.6cqw;
    border-radius: 50%;
    background: currentColor;
    animation: blink 1.4s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  .hl-grid-head {
    display: flex;
    justify-content: space-between;
    font-size: 3.2cqw;
    font-weight: 600;
    color: var(--navy);
  }
  .hl-legend {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    color: #7a7f8c;
    font-weight: 500;
    font-size: 2.6cqw;
  }
  .hl-legend i {
    width: 2.4cqw;
    height: 2.4cqw;
    border-radius: 0.8cqw;
    margin-left: 1.6cqw;
  }
  .l-done {
    background: var(--navy);
  }
  .l-res {
    border: 0.5cqw solid var(--gold);
  }
  .hl-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.8cqw;
  }
  .juz {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 2.6cqw;
    background: #ebe6da;
    color: #6b7180;
    font-size: 3.2cqw;
    font-weight: 600;
    transition: background 0.5s, color 0.5s, box-shadow 0.5s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .juz i {
    position: absolute;
    top: -1.2cqw;
    right: -1.2cqw;
    display: grid;
    place-items: center;
    width: 4.4cqw;
    height: 4.4cqw;
    border-radius: 50%;
    border: 0.5cqw solid #f6f3ec;
    color: #fff;
    font-size: 2.2cqw;
    font-style: normal;
    font-weight: 700;
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .juz.reserved {
    background: #fff;
    color: var(--navy);
    box-shadow: inset 0 0 0 0.6cqw var(--gold);
  }
  .juz.reserved i {
    transform: scale(1);
  }
  .juz.done {
    background: var(--navy);
    color: #fff;
  }
  .juz.pop {
    transform: scale(1.18);
  }
  .juz.pick {
    background: var(--gold);
    color: #fff;
    box-shadow: 0 0 0 1cqw rgba(224, 164, 58, 0.25);
  }
  .hl-feed {
    display: flex;
    align-items: center;
    gap: 2.4cqw;
    padding: 2.6cqw 3cqw;
    border-radius: 4cqw;
    background: #fff;
    font-size: 3cqw;
    box-shadow: 0 1cqw 4cqw rgba(18, 24, 38, 0.06);
  }
  .hl-feed-dot {
    display: grid;
    place-items: center;
    width: 6cqw;
    height: 6cqw;
    border-radius: 50%;
    color: #fff;
    font-weight: 700;
    font-size: 2.6cqw;
    flex: none;
    transition: background 0.3s;
  }
  .hl-feed-time {
    margin-left: auto;
    color: #8a8f9c;
    font-size: 2.6cqw;
  }
  .hl-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    padding: 3cqw 6cqw 22cqw;
    border-radius: 7cqw 7cqw 0 0;
    background: #fff;
    box-shadow: 0 -3cqw 10cqw rgba(18, 24, 38, 0.14);
  }
  .hl-grab {
    width: 10cqw;
    height: 1.2cqw;
    margin: 0 auto 3cqw;
    border-radius: 1cqw;
    background: #d9d5cb;
  }
  .hl-sheet-title {
    font-size: 5cqw;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  .hl-sheet-sub {
    font-size: 3cqw;
    color: #7a7f8c;
    margin: 0.6cqw 0 3.6cqw;
  }
  .hl-sheet-btn {
    display: grid;
    place-items: center;
    height: 11cqw;
    border-radius: 4cqw;
    background: var(--navy);
    color: #fff;
    font-weight: 600;
    font-size: 3.6cqw;
    transition: transform 0.25s, background 0.3s;
  }
  .hl-sheet-btn.press {
    transform: scale(0.95);
  }
  .hl-sheet-btn.ok {
    background: #10b981;
  }
  .hl-tabs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
    justify-content: space-around;
    padding: 2.6cqw 6cqw 7cqw;
    background: rgba(246, 243, 236, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(18, 24, 38, 0.06);
    font-size: 2.5cqw;
    color: #9aa0ab;
  }
  .hl-tabs span {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8cqw;
  }
  .hl-tabs svg {
    width: 6cqw;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .hl-tabs .on {
    color: var(--navy);
    font-weight: 600;
  }
  .hl-tabs .on svg {
    fill: var(--navy);
  }
</style>
