---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects, quronimShots } from '../data/profile';
import miftahul from '../assets/icons/miftahul.png';
import Icon from './Icon.astro';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/quronim/*.jpg', { eager: true });
const shots = await Promise.all(
  Object.keys(files)
    .sort()
    .map(async (k, i) => {
      const src = files[k].default;
      const large = await getImage({ src, width: 720, format: 'webp' });
      return { src, large: large.src, alt: quronimShots[i] ?? 'Quronim screenshot' };
    }),
);
---

<section class="section" id="work">
  <div class="container">
    <span class="kicker" data-reveal>Work</span>
    <h2 class="title" data-split>Selected projects</h2>
    <p class="lead" data-reveal>Apps I’ve designed, built and shipped to the App Store.</p>

    <div class="grid">
      {
        projects.map((p) => (
          <article class="project card" data-reveal>
            <div class:list={['cover', p.cover]} style={`--c:${p.color}`}>
              <span class="badge">
                {p.link ? <Icon name="apple" /> : <span class="badge-dot" />}
                {p.badge}
              </span>
              {p.cover === 'gallery' ? (
                <div class="strip" data-strip>
                  <div class="strip-track">
                    {[0, 1].map((copy) =>
                      shots.map((s) => (
                        <button
                          class="shot"
                          data-full={s.large}
                          data-alt={s.alt}
                          aria-label={`Open screenshot: ${s.alt}`}
                          aria-hidden={copy === 1 ? 'true' : undefined}
                          tabindex={copy === 1 ? -1 : undefined}>
                          <Image src={s.src} alt={copy === 0 ? s.alt : ''} width={150} densities={[1, 2]} loading="eager" decoding="async" />
                        </button>
                      )),
                    )}
                  </div>
                </div>
              ) : (
                <Image src={miftahul} alt={`${p.name} app icon`} width={128} height={128} class="cover-icon" />
              )}
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              <p class="text">{p.text}</p>
              <ul class="points">
                {p.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
              <div class="tags">
                {p.tags.map((t) => (
                  <span class="chip">{t}</span>
                ))}
              </div>
              {p.link && (
                <a class="btn btn-ghost store" href={p.link.href} target="_blank" rel="noopener">
                  <Icon name="apple" />
                  {p.link.label}
                  <Icon name="arrow-up-right" />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Screenshot">
    <img alt="" />
    <button class="lb-close" aria-label="Close">✕</button>
  </dialog>
</section>

<style>
  .grid {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .cover {
    position: relative;
    height: 320px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(70% 90% at 50% 100%, color-mix(in srgb, var(--c) 90%, white 10%), transparent 75%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), color-mix(in srgb, var(--c) 35%, transparent));
  }
  .cover.icon {
    display: grid;
    place-items: center;
  }
  .cover :global(.cover-icon) {
    width: 120px;
    height: 120px;
    border-radius: 28px;
    box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.6);
    transition: transform 0.7s var(--ease-out);
  }
  .project:hover .cover :global(.cover-icon) {
    transform: scale(1.08) rotate(-4deg);
  }
  .badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(9, 9, 11, 0.7);
    border: 1px solid var(--line-2);
    backdrop-filter: blur(8px);
    font-size: 12.5px;
    font-weight: 600;
  }
  .badge :global(svg) {
    width: 13px;
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-2);
  }

  /* screenshot strip: slowly scrolls, pauses on hover */
  .strip {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .strip-track {
    display: flex;
    gap: 14px;
    padding: 46px 0 18px;
    width: max-content;
    animation: strip 36s linear infinite;
  }
  .strip:hover .strip-track,
  .strip:focus-within .strip-track {
    animation-play-state: paused;
  }
  @keyframes strip {
    to {
      transform: translateX(calc(-50% - 7px));
    }
  }
  .shot {
    flex: none;
    width: 118px;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 16px 30px -14px rgba(0, 0, 0, 0.7);
    transition: transform 0.4s var(--ease-out);
    cursor: zoom-in;
  }
  .shot:hover {
    transform: translateY(-6px) scale(1.04);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 26px;
  }
  h3 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .tagline {
    margin: 2px 0 0;
    color: var(--accent-2);
    font-weight: 500;
  }
  .text {
    margin: 14px 0 14px;
    color: var(--ink-soft);
  }
  .points {
    display: grid;
    gap: 7px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .points li {
    position: relative;
    padding-left: 18px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }
  .store {
    align-self: flex-start;
    margin-top: 20px;
    height: 42px;
    font-size: 14px;
  }
  .store :global(svg:last-child) {
    width: 15px;
    opacity: 0.6;
  }

  .lightbox {
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 24px;
    border: 0;
    background: transparent;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(6px);
  }
  .lightbox img {
    max-width: min(420px, 100%);
    max-height: calc(100vh - 48px);
    width: auto;
    height: auto;
    border-radius: 22px;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8);
  }
  .lb-close {
    position: fixed;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 16px;
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip {
      overflow-x: auto;
    }
    .strip-track {
      animation: none;
    }
  }
</style>
